{
  "_createdAt": "2026-03-31T14:59:26Z",
  "_id": "drafts.post-granola-hubspot-integration-crm-updates",
  "_rev": "AvyC4d6ng0Vv1OIiyhLoEC",
  "_type": "post",
  "_updatedAt": "2026-08-05T07:16:35Z",
  "body": [
    {
      "_key": "476b9325efc1",
      "_type": "block",
      "children": [
        {
          "_key": "6c2aed665b2d",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "TL;DR:"
        },
        {
          "_key": "242f418d8a01",
          "_type": "span",
          "marks": [],
          "text": " Connecting Granola to HubSpot means your customer conversation notes stop living in a private document and start living where your team can find them. The native integration (available on Business and Enterprise plans) lets you sync enhanced meeting notes directly to HubSpot Contact records in a single click. For fully automated syncing without any manual step, Zapier bridges the gap. The result is a CRM that reflects real customer conversations, not blank activity logs.\n"
        }
      ],
      "markDefs": [],
      "style": "blockquote"
    },
    {
      "_key": "8684cd31fe70",
      "_type": "block",
      "children": [
        {
          "_key": "6f52f8b46807",
          "_type": "span",
          "marks": [],
          "text": "Research insights, deal context, and customer feedback live in private notebooks while your team lives in HubSpot. If it's not logged in the CRM, it doesn't exist for anyone but you."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "133af6dd48d0",
      "_type": "block",
      "children": [
        {
          "_key": "732f0880918d",
          "_type": "span",
          "marks": [],
          "text": "Connecting Granola to HubSpot closes that loop. You jot your notes during the meeting, "
        },
        {
          "_key": "35306ef4eda6",
          "_type": "span",
          "marks": [
            "f172fabf77b1"
          ],
          "text": "Granola enhances them with relevant context"
        },
        {
          "_key": "159ae2acf167",
          "_type": "span",
          "marks": [],
          "text": " from the transcript, and then you push that polished summary directly to the right HubSpot record."
        }
      ],
      "markDefs": [
        {
          "_key": "f172fabf77b1",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/taking-notes/ai-enhanced-notes"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "b6d3c30216df",
      "_type": "block",
      "children": [
        {
          "_key": "11c8cf0d770b",
          "_type": "span",
          "marks": [],
          "text": "Why sync meeting notes to HubSpot?"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "c8719c9d572f",
      "_type": "block",
      "children": [
        {
          "_key": "ba0d1d3234e4",
          "_type": "span",
          "marks": [],
          "text": "Syncing to HubSpot solves two distinct problems at once:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "596d9717c8f3",
      "_type": "block",
      "children": [
        {
          "_key": "a753f873c8b1",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Institutional memory:"
        },
        {
          "_key": "9607085fec3a",
          "_type": "span",
          "marks": [],
          "text": " Every customer conversation becomes searchable inside the tool your whole team already uses, not buried in one person's notes folder."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c972c7dc1bb7",
      "_type": "block",
      "children": [
        {
          "_key": "767f16365e3d",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Zero admin:"
        },
        {
          "_key": "6adb1c676567",
          "_type": "span",
          "marks": [],
          "text": " The post-call data entry that currently pulls you away from your next meeting drops to a single click."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "1778894aa9b8",
      "_type": "block",
      "children": [
        {
          "_key": "a1a3c3eb8be8",
          "_type": "span",
          "marks": [],
          "text": "\"The time saved in adding notes to CRM and removed from admin follow ups. Great integrations.\" - "
        },
        {
          "_key": "331c4f9840af",
          "_type": "span",
          "marks": [
            "b48d11ac6e2c"
          ],
          "text": "Rakeem L. on G2"
        },
        {
          "_key": "88e4f8da1fcd",
          "_type": "span",
          "marks": [],
          "text": "\n"
        }
      ],
      "markDefs": [
        {
          "_key": "b48d11ac6e2c",
          "_type": "link",
          "href": "https://g2.com/products/granola/reviews/granola-review-9966796"
        }
      ],
      "style": "blockquote"
    },
    {
      "_key": "5ff2e185344a",
      "_type": "block",
      "children": [
        {
          "_key": "f3060f9fa785",
          "_type": "span",
          "marks": [],
          "text": "Prerequisites for the integration"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "94d6a37f33df",
      "_type": "block",
      "children": [
        {
          "_key": "8d0dc4b932bc",
          "_type": "span",
          "marks": [],
          "text": "Before you connect, verify you have the following in place:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "d1744a9994f5",
      "_type": "block",
      "children": [
        {
          "_key": "8005ec4f8c5a",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "A Granola Business or Enterprise plan."
        },
        {
          "_key": "87914f0aff9d",
          "_type": "span",
          "marks": [],
          "text": " The free plan does not include the HubSpot integration. Business starts at $14 per user per month, and you can verify current plan features on the "
        },
        {
          "_key": "341b6db9c923",
          "_type": "span",
          "marks": [
            "8a0abf3ce26b"
          ],
          "text": "Granola pricing and plans page"
        },
        {
          "_key": "65251e3f05d9",
          "_type": "span",
          "marks": [],
          "text": "."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [
        {
          "_key": "8a0abf3ce26b",
          "_type": "link",
          "href": "https://www.granola.ai/pricing"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "a31a2738d328",
      "_type": "block",
      "children": [
        {
          "_key": "458017722d04",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "A work email connected to Granola."
        },
        {
          "_key": "cd44e18d1978",
          "_type": "span",
          "marks": [],
          "text": " Use the same work account in Granola and HubSpot when authorizing the connection."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "be8da6c237ba",
      "_type": "block",
      "children": [
        {
          "_key": "3716e26a8d7c",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "HubSpot admin access."
        },
        {
          "_key": "5d921edf5740",
          "_type": "span",
          "marks": [],
          "text": " You need Super Admin permissions or App Marketplace access within HubSpot to authorize the connection."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "98c18b5acd42",
      "_type": "block",
      "children": [
        {
          "_key": "1260632866c5",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "A synced calendar."
        },
        {
          "_key": "cee7d5d863be",
          "_type": "span",
          "marks": [],
          "text": " Granola matches notes to HubSpot records using meeting attendee emails, so your "
        },
        {
          "_key": "b377b9f86beb",
          "_type": "span",
          "marks": [
            "5d7601bad8c6"
          ],
          "text": "calendar needs to be connected"
        },
        {
          "_key": "f03c90cebf25",
          "_type": "span",
          "marks": [],
          "text": " to surface accurate attendee data."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [
        {
          "_key": "5d7601bad8c6",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/getting-started/syncing-your-calendars"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "2d5a67fe9e24",
      "_type": "block",
      "children": [
        {
          "_key": "465dbeda204d",
          "_type": "span",
          "marks": [],
          "text": "How to set up the direct HubSpot integration"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "df5cc00eca49",
      "_type": "block",
      "children": [
        {
          "_key": "9f7d19d4fa81",
          "_type": "span",
          "marks": [],
          "text": "The "
        },
        {
          "_key": "6ccebfaab881",
          "_type": "span",
          "marks": [
            "21ca20f9c8c9"
          ],
          "text": "official HubSpot integration guide"
        },
        {
          "_key": "13a86170f9d7",
          "_type": "span",
          "marks": [],
          "text": " walks through each step in detail. Here's the full setup path."
        }
      ],
      "markDefs": [
        {
          "_key": "21ca20f9c8c9",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/sharing/integrations/hub-spot"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "96070fca634e",
      "_type": "block",
      "children": [
        {
          "_key": "59c500ba459b",
          "_type": "span",
          "marks": [],
          "text": "Step 1: Connect your HubSpot account"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "970efa7c118d",
      "_type": "block",
      "children": [
        {
          "_key": "a4fed5776926",
          "_type": "span",
          "marks": [],
          "text": "Open Granola and click your "
        },
        {
          "_key": "b1fbe5b649b8",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "avatar"
        },
        {
          "_key": "e34e89f7c429",
          "_type": "span",
          "marks": [],
          "text": " in the bottom left corner."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "7ae348a05696",
      "_type": "block",
      "children": [
        {
          "_key": "81409b8f7a13",
          "_type": "span",
          "marks": [],
          "text": "Navigate to "
        },
        {
          "_key": "4dea61ce26f2",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Settings"
        },
        {
          "_key": "4354a4460148",
          "_type": "span",
          "marks": [],
          "text": ", then select "
        },
        {
          "_key": "7fbcff6d60e4",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Integrations"
        },
        {
          "_key": "d5cf6a526ae9",
          "_type": "span",
          "marks": [],
          "text": "."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b894f0b3994b",
      "_type": "block",
      "children": [
        {
          "_key": "0e18adfd833f",
          "_type": "span",
          "marks": [],
          "text": "Click "
        },
        {
          "_key": "6c5c56ac51b0",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Connect"
        },
        {
          "_key": "af9773c98594",
          "_type": "span",
          "marks": [],
          "text": " next to HubSpot."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "fcff79a51176",
      "_type": "block",
      "children": [
        {
          "_key": "d130cb6d27fb",
          "_type": "span",
          "marks": [],
          "text": "A browser window opens, prompting you to log in to HubSpot and authorize permissions."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "7928684f0479",
      "_type": "block",
      "children": [
        {
          "_key": "c110896d2414",
          "_type": "span",
          "marks": [],
          "text": "Grant access and return to Granola. The integration status updates to connected."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c337c4fe7314",
      "_type": "block",
      "children": [
        {
          "_key": "820a93bd1e8c",
          "_type": "span",
          "marks": [],
          "text": "Make sure both your Granola account and your HubSpot account use the same email address."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "1b8caffd2bbb",
      "_type": "block",
      "children": [
        {
          "_key": "5a54b76877bf",
          "_type": "span",
          "marks": [],
          "text": "Step 2: Sync a note to HubSpot"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "795466014aa4",
      "_type": "block",
      "children": [
        {
          "_key": "c7f3fc1b02b7",
          "_type": "span",
          "marks": [],
          "text": "After a meeting, open the note in Granola and click "
        },
        {
          "_key": "f5bc9675eeb9",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Share"
        },
        {
          "_key": "83937e42779a",
          "_type": "span",
          "marks": [],
          "text": ". Select HubSpot from the sharing options. Granola suggests Contact records based on attendee email addresses from the calendar invite, so the right match usually surfaces immediately. Confirm the selection and the note appears in the HubSpot activity timeline."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "4380c40a1efe",
      "_type": "block",
      "children": [
        {
          "_key": "6f88ef6116fa",
          "_type": "span",
          "marks": [],
          "text": "The sync includes the meeting title, date, participant list, your enhanced note body, and any action items Granola extracted. If you've used custom templates in Granola, those sections carry over as formatted text in the HubSpot activity note."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "5a59c84c5116",
      "_type": "block",
      "children": [
        {
          "_key": "86d623e3ac93",
          "_type": "span",
          "marks": [],
          "text": "This sync happens one note at a time. You choose which record receives the data after each meeting, giving you control over what gets logged and where. For fully automatic syncing with no manual step, use Zapier (covered in the next section)."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "ff99087476d0",
      "_type": "block",
      "children": [
        {
          "_key": "31a6ff2e478c",
          "_type": "span",
          "marks": [],
          "text": "Step 3: Verify the result in HubSpot"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "476365cef9f2",
      "_type": "block",
      "children": [
        {
          "_key": "824bf664ac2b",
          "_type": "span",
          "marks": [],
          "text": "Navigate to the HubSpot record you selected and check the "
        },
        {
          "_key": "a199fd534ae5",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Activity"
        },
        {
          "_key": "5400c3ffc377",
          "_type": "span",
          "marks": [],
          "text": " tab. Your enhanced Granola notes appear there, timestamped and attributed to the meeting. Teammates with access to that record can read the full conversation context without asking you for a debrief."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "7cc32d659de1",
      "_type": "block",
      "children": [
        {
          "_key": "030eb6bcae28",
          "_type": "span",
          "marks": [],
          "text": "\"Granola does not need to join your meeting. I really like their offering and upgraded to the Business plan.\" - "
        },
        {
          "_key": "ef8a737eb121",
          "_type": "span",
          "marks": [
            "5235acab1c39"
          ],
          "text": "Verified user on G2"
        },
        {
          "_key": "ed559dea5593",
          "_type": "span",
          "marks": [],
          "text": "\n"
        }
      ],
      "markDefs": [
        {
          "_key": "5235acab1c39",
          "_type": "link",
          "href": "https://g2.com/products/granola/reviews/granola-review-11412901"
        }
      ],
      "style": "blockquote"
    },
    {
      "_key": "0a5cee97b495",
      "_type": "block",
      "children": [
        {
          "_key": "d485094e9dde",
          "_type": "span",
          "marks": [],
          "text": "Alternative connection method: Zapier"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "db86a1d7893e",
      "_type": "block",
      "children": [
        {
          "_key": "c550d9b6e232",
          "_type": "span",
          "marks": [],
          "text": "When you need syncing to happen automatically (without a manual share step after each meeting), Zapier is the right tool. The "
        },
        {
          "_key": "47c10ff15fce",
          "_type": "span",
          "marks": [
            "d4c9bc096c63"
          ],
          "text": "Granola + HubSpot Zapier integration"
        },
        {
          "_key": "feed787b9371",
          "_type": "span",
          "marks": [],
          "text": " supports two primary triggers:"
        }
      ],
      "markDefs": [
        {
          "_key": "d4c9bc096c63",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/sharing/integrations/integrations-with-granola"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "ef155b03109e",
      "_type": "block",
      "children": [
        {
          "_key": "6b64f1b5e980",
          "_type": "span",
          "marks": [],
          "text": "A new note sent from Granola"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "0b57c5808eec",
      "_type": "block",
      "children": [
        {
          "_key": "00ba88f97ef5",
          "_type": "span",
          "marks": [],
          "text": "A new note added to a specific Granola folder"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "522fba0ccde6",
      "_type": "block",
      "children": [
        {
          "_key": "75740ee5d3e7",
          "_type": "span",
          "marks": [],
          "text": "From either trigger, you build a Zap that looks up the relevant HubSpot Contact and posts the note to it. The "
        },
        {
          "_key": "ee8ed04d2ce3",
          "_type": "span",
          "marks": [
            "0b476a35aa9d"
          ],
          "text": "Zapier automation guide for Granola"
        },
        {
          "_key": "cfda461bede0",
          "_type": "span",
          "marks": [],
          "text": " covers how to configure the lookup step to match on email address, so the note lands in the right place without manual selection."
        }
      ],
      "markDefs": [
        {
          "_key": "0b476a35aa9d",
          "_type": "link",
          "href": "https://zapier.com/blog/automate-granola/"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "90e718de3daa",
      "_type": "block",
      "children": [
        {
          "_key": "c618fafef521",
          "_type": "span",
          "marks": [],
          "text": "Zapier also handles scenarios the native integration doesn't cover: routing notes based on folder assignment, pushing data to multiple HubSpot objects in one workflow, or triggering actions in other tools at the same time. Granola's "
        },
        {
          "_key": "9423b984e71d",
          "_type": "span",
          "marks": [
            "b08cd15f5791"
          ],
          "text": "Zapier integration documentation"
        },
        {
          "_key": "de760201a714",
          "_type": "span",
          "marks": [],
          "text": " covers the trigger configuration in detail, and the "
        },
        {
          "_key": "e7e8fcc7b191",
          "_type": "span",
          "marks": [
            "92eff4a726db"
          ],
          "text": "broader integrations overview"
        },
        {
          "_key": "e051cc61c1d5",
          "_type": "span",
          "marks": [],
          "text": " shows how this connects to the wider automation ecosystem."
        }
      ],
      "markDefs": [
        {
          "_key": "b08cd15f5791",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/sharing/integrations/zapier"
        },
        {
          "_key": "92eff4a726db",
          "_type": "link",
          "href": "https://www.granola.ai/blog/your-meeting-notes-now-connected-with-8000-apps"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "84fa4258d757",
      "_type": "block",
      "children": [
        {
          "_key": "bd22e37f1f1b",
          "_type": "span",
          "marks": [],
          "text": "How sales and product teams use the integration"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "bbbe584e90a4",
      "_type": "block",
      "children": [
        {
          "_key": "576a240dcc0a",
          "_type": "span",
          "marks": [],
          "text": "Enriching deal records after sales calls"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "3f259c55ffb2",
      "_type": "block",
      "children": [
        {
          "_key": "0d7c73963144",
          "_type": "span",
          "marks": [],
          "text": "After a discovery call, open the meeting note in Granola. Granola has already enhanced your jotted notes with relevant quotes from the transcript. The summary already contains budget signals, timeline information, and next steps. Share it to the relevant HubSpot Contact record, and the pipeline context is updated before you've closed your laptop."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "d628d6d864ee",
      "_type": "block",
      "children": [
        {
          "_key": "1b9065e0807f",
          "_type": "span",
          "marks": [],
          "text": "Sales managers see deal context without asking reps for updates. Reps stop spending time at the end of each day filling in CRM fields they already captured in Granola during the call."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "5bcaaf6c4a8e",
      "_type": "block",
      "children": [
        {
          "_key": "10fd8d4b8190",
          "_type": "span",
          "marks": [],
          "text": "\"Granola nails exactly what I need: clean, reliable meeting transcripts and smart follow-up summaries without any fluff. The follow-up action items are especially useful. Huge time saver.\" - "
        },
        {
          "_key": "5b76f3d51bf1",
          "_type": "span",
          "marks": [
            "08ddcc09a81e"
          ],
          "text": "Verified user on G2"
        },
        {
          "_key": "78e38f40cc7e",
          "_type": "span",
          "marks": [],
          "text": "\n"
        }
      ],
      "markDefs": [
        {
          "_key": "08ddcc09a81e",
          "_type": "link",
          "href": "https://g2.com/products/granola/reviews/granola-review-11289286"
        }
      ],
      "style": "blockquote"
    },
    {
      "_key": "0d08c79e4e2a",
      "_type": "block",
      "children": [
        {
          "_key": "67d5375dba2a",
          "_type": "span",
          "marks": [],
          "text": "Centralizing customer research in the shared record"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "6d46ab3efdeb",
      "_type": "block",
      "children": [
        {
          "_key": "c2e4d633cc29",
          "_type": "span",
          "marks": [],
          "text": "The integration also solves a quieter problem: insights that stay trapped in private tools and never reach the colleagues who need them. When a meeting surfaces a specific workflow frustration or a feature request with real context behind it, that insight should appear on the Contact record in HubSpot where the rest of your team can see it too."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "6845b8730a9d",
      "_type": "block",
      "children": [
        {
          "_key": "484ae7b54571",
          "_type": "span",
          "marks": [],
          "text": "You "
        },
        {
          "_key": "e2b4896aba02",
          "_type": "span",
          "marks": [
            "5585e14cce41"
          ],
          "text": "customize your note template"
        },
        {
          "_key": "c85f133d5dc0",
          "_type": "span",
          "marks": [],
          "text": " to match the structure of a research session, capture what matters during the conversation, then share the polished summary to HubSpot after the call. Your findings become part of the shared customer record, not just your personal Granola archive. Research that previously lived only in your notes folder now shows up for every colleague who touches that account."
        }
      ],
      "markDefs": [
        {
          "_key": "5585e14cce41",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/taking-notes/customise-notes-with-templates"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "7a7a5db03033",
      "_type": "block",
      "children": [
        {
          "_key": "a9927f22a2d2",
          "_type": "span",
          "marks": [],
          "text": "Troubleshooting common sync issues"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "ff002a3daacd",
      "_type": "block",
      "children": [
        {
          "_key": "6152ab08e912",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Notes aren't appearing on the HubSpot record."
        },
        {
          "_key": "996edf2b15f6",
          "_type": "span",
          "marks": [],
          "text": " Check that your Granola and HubSpot accounts use the same email address. Mismatched accounts break the connection at the authorization level."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "7daa087a322d",
      "_type": "block",
      "children": [
        {
          "_key": "c0a6e5c6c006",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "The wrong contact is being suggested."
        },
        {
          "_key": "2e302e720303",
          "_type": "span",
          "marks": [],
          "text": " Granola suggests matches based on attendee email addresses pulled from the calendar invite. If the invite used a different email than the HubSpot Contact record, the match won't surface. Update the Contact's email in HubSpot to match the one on the calendar invite, or select the correct record manually during the share step."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "971d68b127d6",
      "_type": "block",
      "children": [
        {
          "_key": "bce44cc067fb",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "A contact doesn't exist in HubSpot yet."
        },
        {
          "_key": "5f1e8a679ccb",
          "_type": "span",
          "marks": [],
          "text": " The native integration does not create new contacts automatically. Create the Contact record in HubSpot first, then return to Granola to sync the note. For teams who regularly meet prospects not yet in the CRM, a Zapier workflow with a \"find or create contact\" step handles this automatically."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "aaaed8c1010e",
      "_type": "block",
      "children": [
        {
          "_key": "84e5453acd7f",
          "_type": "span",
          "marks": [],
          "text": "Get started"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "d392780e13c1",
      "_type": "block",
      "children": [
        {
          "_key": "c5635bac0b0d",
          "_type": "span",
          "marks": [],
          "text": "Connect HubSpot in Granola Settings > Integrations, and your next customer call's notes can reach HubSpot in a single click, or automatically with Zapier. "
        },
        {
          "_key": "65ff59d84df3",
          "_type": "span",
          "marks": [
            "0ca33bd307d1"
          ],
          "text": "Download Granola"
        },
        {
          "_key": "4a0af624b50f",
          "_type": "span",
          "marks": [],
          "text": " for Mac or Windows and connect your calendar to get started."
        }
      ],
      "markDefs": [
        {
          "_key": "0ca33bd307d1",
          "_type": "link",
          "href": "https://www.granola.ai/download"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "5a65485872ae",
      "_type": "block",
      "children": [
        {
          "_key": "326c8de4a0e9",
          "_type": "span",
          "marks": [],
          "text": "If you're on a free plan and want to see what's included before upgrading, the "
        },
        {
          "_key": "b5c783ea6297",
          "_type": "span",
          "marks": [
            "068be55595df"
          ],
          "text": "integrations overview"
        },
        {
          "_key": "7b690a936c7a",
          "_type": "span",
          "marks": [],
          "text": " lists what's available at each tier. For advanced automation needs, start with the "
        },
        {
          "_key": "d357854e7388",
          "_type": "span",
          "marks": [
            "a2b09de345d5"
          ],
          "text": "Zapier setup guide"
        },
        {
          "_key": "29aef49234f9",
          "_type": "span",
          "marks": [],
          "text": " alongside the native connection."
        }
      ],
      "markDefs": [
        {
          "_key": "068be55595df",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/sharing/integrations/integrations-with-granola"
        },
        {
          "_key": "a2b09de345d5",
          "_type": "link",
          "href": "https://docs.granola.ai/help-center/sharing/integrations/zapier"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "d1eebba63b41",
      "_type": "block",
      "children": [
        {
          "_key": "3d8fc98f3851",
          "_type": "span",
          "marks": [],
          "text": "Frequently asked questions"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "a37f9db7fbac",
      "_type": "block",
      "children": [
        {
          "_key": "1b7feb81ddc6",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Does Granola create new HubSpot contacts automatically?"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "9df310ad489f",
      "_type": "block",
      "children": [
        {
          "_key": "da77c1796842",
          "_type": "span",
          "marks": [],
          "text": "No. The native integration syncs notes to existing records only. To create contacts automatically, set up a Zapier workflow with a \"find or create contact\" step before posting the note."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "41631be50f3c",
      "_type": "block",
      "children": [
        {
          "_key": "b1ea360c12c0",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Can I sync to custom HubSpot objects or custom fields?"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c6c46d1d5dc9",
      "_type": "block",
      "children": [
        {
          "_key": "64b45f7a2101",
          "_type": "span",
          "marks": [],
          "text": "The native integration does not support custom objects or custom field mapping. Use Zapier to route data to custom objects or map specific note sections to custom properties."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c0d83d82adda",
      "_type": "block",
      "children": [
        {
          "_key": "351f0e023141",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Is the HubSpot integration available on the free plan?"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "6da375d340b7",
      "_type": "block",
      "children": [
        {
          "_key": "1da455a3c461",
          "_type": "span",
          "marks": [],
          "text": "No. The HubSpot integration requires a Business or Enterprise plan. Check the "
        },
        {
          "_key": "e9b37d762790",
          "_type": "span",
          "marks": [
            "681b86befb24"
          ],
          "text": "current pricing page"
        },
        {
          "_key": "f9f5f6024b61",
          "_type": "span",
          "marks": [],
          "text": " for up-to-date plan details."
        }
      ],
      "markDefs": [
        {
          "_key": "681b86befb24",
          "_type": "link",
          "href": "https://www.granola.ai/blog/granola-pricing-plans-features-roi"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "8f8df3e2e535",
      "_type": "block",
      "children": [
        {
          "_key": "530b14f6723a",
          "_type": "span",
          "marks": [],
          "text": "Key terms"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "83bbcb6d0cc6",
      "_type": "block",
      "children": [
        {
          "_key": "7258a3204d70",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Activity timeline:"
        },
        {
          "_key": "e80e3eb3523e",
          "_type": "span",
          "marks": [],
          "text": " The HubSpot record section where logged interactions (calls, emails, notes) appear in chronological order. Granola notes appear here after syncing."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "6afada002ad1",
      "_type": "block",
      "children": [
        {
          "_key": "f94699d893f0",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Contact matching:"
        },
        {
          "_key": "a2dba9d1d82f",
          "_type": "span",
          "marks": [],
          "text": " The process Granola uses to suggest which HubSpot Contact to associate a note with, based on attendee email addresses from the calendar invite."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "9ff7afa24b48",
      "_type": "block",
      "children": [
        {
          "_key": "2933ef7e7513",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "AI-enhanced notes:"
        },
        {
          "_key": "ca609e28c459",
          "_type": "span",
          "marks": [],
          "text": " Granola's feature that takes your jotted notes from a meeting and fills in supporting context from the transcript. The enhanced version is what syncs to HubSpot."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "80e3a48287ad",
      "_type": "block",
      "children": [
        {
          "_key": "f4968c614e42",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Zapier trigger:"
        },
        {
          "_key": "ddfeedfabef8",
          "_type": "span",
          "marks": [],
          "text": " The event in Granola (a new note, a note added to a folder) that kicks off an automated Zapier workflow to push data to HubSpot."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "a06590d67ef7",
      "_type": "block",
      "children": [
        {
          "_key": "6676a7b0c215",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "OAuth authorization:"
        },
        {
          "_key": "8a6138f24a7c",
          "_type": "span",
          "marks": [],
          "text": " The permission flow where you log in to HubSpot inside the Granola setup process to grant Granola write access to your CRM records."
        }
      ],
      "markDefs": [],
      "style": "normal"
    }
  ],
  "hidden": true,
  "isFeatured": false,
  "publishedAt": "2026-02-21",
  "slug": {
    "_type": "slug",
    "current": "granola-hubspot-integration-crm-updates"
  },
  "summary": "Connecting Granola to HubSpot means your customer conversation notes stop living in a private document and start living where your team can find them. The native integration lets you sync enhanced meeting notes directly to HubSpot Contact records in a single click.",
  "title": "Granola + HubSpot integration: automatic CRM updates from meeting notes"
}