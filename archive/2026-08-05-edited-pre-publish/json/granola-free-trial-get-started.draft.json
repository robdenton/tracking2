          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Evaluate enhancement quality"
        },
        {
          "_key": "0347d2b77413",
          "_type": "span",
          "marks": [],
          "text": ": Do AI additions match what customers said?"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "be06b9eba2da",
      "_type": "block",
      "children": [
        {
          "_key": "63169853441b",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Try folder-level queries"
        },
        {
          "_key": "1a4c330315a4",
          "_type": "span",
          "marks": [],
          "text": ": Can you find patterns across interviews?"
        }
      ],
      "level": 1,
      "listItem": "bullet",
