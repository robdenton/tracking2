        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "0da1a95ea86d",
      "_type": "block",
      "children": [
        {
          "_key": "8f34130d6262",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Test template customization"
        },
        {
          "_key": "0cb17f8dd53d",
